[Unit]
Description=LiteLLM proxy for Second Brain
After=network.target

[Service]
Type=simple
User=jpietrak
WorkingDirectory=/home/jpietrak/second_brain
EnvironmentFile=/home/jpietrak/second_brain/.env
Environment=PYTHONPATH=/home/jpietrak/second_brain
ExecStart=/home/jpietrak/second_brain/.venv/bin/litellm --config /home/jpietrak/second_brain/config/litellm.yaml --port 4000
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
