# Second Brain -- environment template.
# Copy to .env and fill in your values.  NEVER commit .env (it is gitignored).
#
# The core wiki + research + backend flow runs on the Claude Code subscription
# (Agent SDK credit pool) and is $0 marginal.  The keys below are optional
# unless you want paid/cloud routes.
#
# ── REQUIRED for automation ──────────────────────────────────────────────────

# Subscription OAuth token for `claude -p` automation (scripts/claude_agent.sh).
# Obtain with: claude setup-token
# This draws from the Agent SDK credit pool ($0 marginal, not pay-as-you-go).
CLAUDE_CODE_OAUTH_TOKEN=

# ── OPTIONAL: LiteLLM proxy (local model routing) ───────────────────────────
# The LiteLLM proxy routes requests to Ollama (local/free), Gemini (free tier),
# and Anthropic (metered).  If you do not run the proxy, omit these.

# Console pay-as-you-go API key -- used ONLY by the LiteLLM proxy.
# IMPORTANT: do NOT export this into any shell that runs `claude -p`.
# scripts/claude_agent.sh enforces this by unsetting it automatically.
ANTHROPIC_API_KEY=

# Gemini API key for the free-tier validation/synthesis route (LiteLLM proxy).
# Free tier is sufficient for wiki validation calls.
GEMINI_API_KEY=

# LiteLLM proxy settings (only needed if you run services/litellm/).
LITELLM_PORT=4000
LITELLM_MASTER_KEY=

# ── OPTIONAL: Obsidian Local REST API ───────────────────────────────────────
# Only needed if you use scripts/obsidian_api.sh for live REST edits while
# Obsidian is open.  Install the "Local REST API" plugin (coddingtonbear).
OBSIDIAN_API_KEY=
OBSIDIAN_API_URL=https://127.0.0.1:27124

# ── OPTIONAL: research/web backends ─────────────────────────────────────────
# The shipped wiki + research flow does NOT require these.
# Perplexity web scraping is under review; not part of the default flow.
# PERPLEXITY_API_KEY=   # optional; Tier-2 web harvest (disabled by default)
# XAI_API_KEY=          # optional; not used by the shipped wiki/research flow
# YOUTUBE_API_KEY=      # optional; not used by the shipped wiki/research flow

# ── OPTIONAL: NotebookLM sync ───────────────────────────────────────────────
# Per-vault notebook is set in config/vaults/<name>/vault.yaml (notebooklm_notebook).
# This env var is only a GLOBAL FALLBACK for vaults that leave that field blank.
# Auth via: nlm login  (opens a browser; sessions last ~20 min; $0 -- Google cookies only).
NLM_SYNC_NOTEBOOK=

# ── Vault selector ──────────────────────────────────────────────────────────
# Active vault: picks config/vaults/<VAULT>/ and its vault_path.
# If unset, default_vault in config/secondbrain.yaml is used.
# Use VAULT=all in the nightly run to process every enabled vault.
# VAULT=my-vault-name

# CODE_PATH is resolved automatically from agents/vault_config.py (__file__-relative).
# Override only if the repo is mounted at an unusual path.
# CODE_PATH=/path/to/second_brain
