# Second Brain — environment template. Copy to .env and fill in. NEVER commit .env.
#
# ── Billing pools (see CLAUDE.md "Billing & auth strategy") ──────────────────
# Three separate pools. Route each task to the cheapest one that can do it.
#   - Interactive subscription : your normal Claude Code terminal sessions.
#   - Agent SDK credit         : `claude -p` automation via CLAUDE_CODE_OAUTH_TOKEN.
#   - Pay-as-you-go API        : ANTHROPIC_API_KEY — used ONLY by the LiteLLM proxy.

# Subscription OAuth token for automation (`claude setup-token`). Drives Agent
# SDK credit pool ($0 marginal). Used by scripts/claude_agent.sh.
CLAUDE_CODE_OAUTH_TOKEN=

# Console pay-as-you-go API key. LITELLM ONLY — must NOT be exported into any
# shell that runs `claude -p`, or those calls bill the metered API.
ANTHROPIC_API_KEY=sk-ant-api03-...

# Obsidian Local REST API (coddingtonbear plugin, runs in Windows Obsidian).
# Default scheme is HTTPS on 27124 (self-signed -> curl -k). Set HTTP/27123 only
# if you enable non-encrypted mode in the plugin.
OBSIDIAN_API_KEY=your-obsidian-key
OBSIDIAN_API_URL=https://127.0.0.1:27124

# LiteLLM proxy
LITELLM_PORT=4000
LITELLM_MASTER_KEY=sk-litellm-local-master-key

# Research APIs (optional — key-less fallbacks exist)
PERPLEXITY_API_KEY=
XAI_API_KEY=
GEMINI_API_KEY=
YOUTUBE_API_KEY=

# NotebookLM sync (optional). The `nlm` CLI uses Google browser cookies ($0, no API
# pool). Set to a notebook id (or an `nlm` alias) to enable the nightly sync step.
# Auth via `nlm login`; sessions last ~20 min, so unattended runs may skip gracefully.
NLM_SYNC_NOTEBOOK=

# Canonical paths
VAULT_PATH=/mnt/c/Obsidian/Inference-Disagg
CODE_PATH=/home/jpietrak/second_brain
